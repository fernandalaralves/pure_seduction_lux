# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database - choose "sqlite" (zero config, great for local dev/testing) or
# "postgres" (recommended for production).
DB_DIALECT=sqlite
DB_STORAGE=./data/database.sqlite

# Only used when DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pure_seduction_lux
DB_USER=psl_user
DB_PASSWORD=change_me_strong_password
DB_SSL=false

# Auth secrets (use long random strings in production - e.g. `openssl rand -hex 64`)
JWT_CUSTOMER_SECRET=replace_with_a_long_random_secret
JWT_ADMIN_SECRET=replace_with_another_long_random_secret
JWT_EXPIRES_IN=7d

# First admin user, created automatically by the seed script if no admin exists
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@pureseductionlux.com
SEED_ADMIN_PASSWORD=change_this_password_123

# Store / delivery zone configuration (also editable later in the admin Settings page)
STORE_MUNICIPALITY_CITY=Boa Viagem
STORE_MUNICIPALITY_STATE=CE
STORE_DELIVERY_FEE=3.00
STORE_NAME=Pure Seduction Lux
STORE_PHONE=
STORE_WHATSAPP=

# Mercado Pago (https://www.mercadopago.com.br/developers/panel)
# Use TEST- credentials while developing, then swap for production credentials.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MP_WEBHOOK_SECRET=replace_with_a_webhook_validation_secret
