# Lido automaticamente pelo Docker Compose (docker-compose.yml está nesta
# mesma pasta). Só é necessário se você for subir o Postgres via Docker -
# copie para ".env" (na raiz) e preencha com os MESMOS valores de
# DB_NAME/DB_USER/DB_PASSWORD usados em backend/.env.

DB_NAME=pure_seduction_lux
